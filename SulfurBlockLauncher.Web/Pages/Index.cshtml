@page
@model IndexModel
@{
    ViewData["Title"] = "首页";
    var repo = "https://github.com/X-CODER-ocs/SulfurBlockLauncher";
    var releases = repo + "/releases";
    var issues = repo + "/issues";
}

<!-- Hero -->
<section class="hero">
    <div class="container text-center py-5">
        <span class="hero-badge">跨平台 · 开源 · .NET 10</span>
        <h1 class="hero-title">SulfurBlockLauncher</h1>
        <p class="hero-sub">硫磺方块启动器 —— 一款开源、跨平台的 Minecraft 启动器与实例管理器</p>
        <p class="hero-sub2">同时支持 Java 版与基岩版，覆盖 Windows / Linux / macOS</p>
        <div class="hero-actions">
            <a class="btn btn-download btn-lg" href="@releases" target="_blank" rel="noopener">⬇ 下载最新版</a>
            <a class="btn btn-outline-light btn-lg" href="@repo" target="_blank" rel="noopener">在 GitHub 查看源码</a>
        </div>
    </div>
</section>

<!-- Features -->
<section id="features" class="section">
    <div class="container">
        <h2 class="section-title">核心功能</h2>
        <p class="section-lead">少一点配置，多一点游戏。从安装、登录到资源管理与联机，一站式搞定。</p>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">🗂️</div>
                    <h5>标签页式导航</h5>
                    <p>清晰的多标签页界面，游戏、下载、账户、存档分区管理，操作一气呵成。</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">🟩</div>
                    <h5>Java 版 / 基岩版</h5>
                    <p>同时支持 Java 版与基岩版启动管理，原版、加载器与游戏本体一键安装。</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">📦</div>
                    <h5>下载管理</h5>
                    <p>Java、MCJE、模组等资源统一下载与管理，文件自动归入对应目录。</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">👤</div>
                    <h5>账户管理</h5>
                    <p>支持正版、离线、外置登录等多种账户类型，切换账户轻松自如。</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">💾</div>
                    <h5>存档管理</h5>
                    <p>存档备份、编辑与管理，珍贵世界不再因误操作而丢失。</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">🔗</div>
                    <h5>联机功能</h5>
                    <p>内置陶瓦联机、硫磺联机，和朋友一起开黑就是这么简单。</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Download -->
<section id="download" class="section section-alt">
    <div class="container">
        <h2 class="section-title">下载</h2>
        <p class="section-lead">前往 GitHub Releases 获取对应平台的最新版本。</p>
        <div class="row g-3 justify-content-center">
            <div class="col-6 col-md-3">
                <a class="download-card" href="@releases" target="_blank" rel="noopener">
                    <div class="download-os">Windows</div>
                    <div class="download-meta">10 / 11 · x64</div>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a class="download-card" href="@releases" target="_blank" rel="noopener">
                    <div class="download-os">macOS</div>
                    <div class="download-meta">Apple Silicon / Intel</div>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a class="download-card" href="@releases" target="_blank" rel="noopener">
                    <div class="download-os">Linux</div>
                    <div class="download-meta">x64 · AppImage / deb / rpm</div>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a class="download-card" href="@releases" target="_blank" rel="noopener">
                    <div class="download-os">Arch Linux</div>
                    <div class="download-meta">AUR 包</div>
                </a>
            </div>
        </div>
        <div class="text-center mt-4">
            <a class="btn btn-download btn-lg" href="@releases" target="_blank" rel="noopener">前往 Releases 下载</a>
        </div>
    </div>
</section>

<!-- Feedback & Contact -->
<section id="feedback" class="section">
    <div class="container">
        <h2 class="section-title">反馈与联系</h2>
        <p class="section-lead">遇到问题或有好点子？随时告诉我们。</p>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card feedback-card h-100">
                    <div class="feature-icon mb-2">💬</div>
                    <h5>提交反馈 / Bug 报告</h5>
                    <p class="text-secondary">本项目使用 GitHub Issues 收集反馈与问题。遇到 Bug 或想要新功能，欢迎直接到 Issues 提出。</p>
                    <div class="mt-auto">
                        <a class="btn btn-download" href="@issues" target="_blank" rel="noopener">前往 GitHub Issues</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card feedback-card h-100">
                    <div class="feature-icon mb-2">🐧</div>
                    <h5>QQ 联系</h5>
                    <p class="text-secondary">也可以通过 QQ 直接联系开发者：</p>
                    <p class="qq-number">QQ：545716736</p>
                    <div class="mt-auto">
                        <button class="btn btn-outline-secondary btn-sm" type="button" onclick="copyQQ()">复制 QQ 号</button>
                        <span id="qqTip" class="qq-tip">已复制！</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-4">
            <a class="btn btn-outline-light" href="@repo" target="_blank" rel="noopener">在 GitHub 上关注项目</a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function copyQQ() {
            navigator.clipboard.writeText("2280009304").then(function () {
                var tip = document.getElementById("qqTip");
                tip.classList.add("show");
                setTimeout(function () { tip.classList.remove("show"); }, 1500);
            });
        }
    </script>
}
