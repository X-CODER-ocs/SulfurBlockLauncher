@page "/"
@using Microsoft.FluentUI.AspNetCore.Components
@inject IJSRuntime JS

<PageTitle>首页 - SulfurBlockLauncher 硫磺方块启动器</PageTitle>

<!-- Hero -->
<section class="hero">
    <div class="container text-center py-5">
        <FluentBadge Appearance="Appearance.Accent" Class="hero-badge">跨平台 · 开源 · .NET 10</FluentBadge>
        <h1 class="hero-title">SulfurBlockLauncher</h1>
        <p class="hero-sub">硫磺方块启动器 —— 一款开源、跨平台的 Minecraft 启动器与实例管理器</p>
        <p class="hero-sub2">同时支持 Java 版与基岩版，覆盖 Windows / Linux / macOS</p>
        <div class="hero-actions">
            <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Large" OnClick="@(() => OpenUrl(Releases))">⬇ 下载最新版</FluentButton>
            <FluentButton Appearance="Appearance.Lightweight" Style="color:#fff;border-color:rgba(255,255,255,.5);" Size="ButtonSize.Large" OnClick="@(() => OpenUrl(Repo))">在 GitHub 查看源码</FluentButton>
        </div>
    </div>
</section>

<!-- Features -->
<section id="features" class="section">
    <div class="container">
        <h2 class="section-title">核心功能</h2>
        <p class="section-lead">少一点配置，多一点游戏。从安装、登录到资源管理与联机，一站式搞定。</p>
        <div class="row g-4">
            @foreach (var f in Features)
            {
                <div class="col-md-6 col-lg-4">
                    <FluentCard Class="feature-card h-100">
                        <div class="feature-icon">@f.Icon</div>
                        <h5>@f.Title</h5>
                        <p>@f.Desc</p>
                    </FluentCard>
                </div>
            }
        </div>
    </div>
</section>

<!-- Download -->
<section id="download" class="section section-alt">
    <div class="container">
        <h2 class="section-title">下载</h2>
        <p class="section-lead">前往 GitHub Releases 获取对应平台的最新版本。</p>
        <div class="row g-3 justify-content-center">
            @foreach (var d in Downloads)
            {
                <div class="col-6 col-md-3">
                    <FluentCard Class="download-card h-100" Style="cursor:pointer;text-align:center;" OnClick="@(() => OpenUrl(Releases))">
                        <div class="download-os">@d.Os</div>
                        <div class="download-meta">@d.Meta</div>
                    </FluentCard>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Large" OnClick="@(() => OpenUrl(Releases))">前往 Releases 下载</FluentButton>
        </div>
    </div>
</section>

<!-- Feedback & Contact -->
<section id="feedback" class="section">
    <div class="container">
        <h2 class="section-title">反馈与联系</h2>
        <p class="section-lead">遇到问题或有好点子？随时告诉我们。</p>
        <div class="row g-4">
            <div class="col-md-6">
                <FluentCard Class="feedback-card h-100">
                    <div class="feature-icon mb-2">💬</div>
                    <h5>提交反馈 / Bug 报告</h5>
                    <p class="text-secondary">本项目使用 GitHub Issues 收集反馈与问题。遇到 Bug 或想要新功能，欢迎直接到 Issues 提出。</p>
                    <div class="mt-auto">
                        <FluentButton Appearance="Appearance.Accent" OnClick="@(() => OpenUrl(Issues))">前往 GitHub Issues</FluentButton>
                    </div>
                </FluentCard>
            </div>
            <div class="col-md-6">
                <FluentCard Class="feedback-card h-100">
                    <div class="feature-icon mb-2">🐧</div>
                    <h5>QQ 联系</h5>
                    <p class="text-secondary">也可以通过 QQ 直接联系开发者：</p>
                    <p class="qq-number">QQ：@QQ</p>
                    <div class="mt-auto">
                        <FluentButton Appearance="Appearance.Neutral" Size="ButtonSize.Small" OnClick="CopyQQ">复制 QQ 号</FluentButton>
                        <span id="qqTip" class="qq-tip @(_copied ? "show" : "")">已复制！</span>
                    </div>
                </FluentCard>
            </div>
        </div>
        <div class="text-center mt-4">
            <FluentButton Appearance="Appearance.Lightweight" Style="color:#fff;border-color:rgba(255,255,255,.5);" OnClick="@(() => OpenUrl(Repo))">在 GitHub 上关注项目</FluentButton>
        </div>
    </div>
</section>

@code {
    private const string Repo = "https://github.com/X-CODER-ocs/SulfurBlockLauncher";
    private const string Releases = Repo + "/releases";
    private const string Issues = Repo + "/issues";
    private const string QQ = "2280009304";

    private bool _copied;

    private record Feature(string Icon, string Title, string Desc);

    private readonly List<Feature> Features = new()
    {
        new("🗂️", "标签页式导航", "清晰的多标签页界面，游戏、下载、账户、存档分区管理，操作一气呵成。"),
        new("🟩", "Java 版 / 基岩版", "同时支持 Java 版与基岩版启动管理，原版、加载器与游戏本体一键安装。"),
        new("📦", "下载管理", "Java、MCJE、模组等资源统一下载与管理，文件自动归入对应目录。"),
        new("👤", "账户管理", "支持正版、离线、外置登录等多种账户类型，切换账户轻松自如。"),
        new("💾", "存档管理", "存档备份、编辑与管理，珍贵世界不再因误操作而丢失。"),
        new("🔗", "联机功能", "内置陶瓦联机、硫磺联机，和朋友一起开黑就是这么简单。"),
    };

    private record Download(string Os, string Meta);

    private readonly List<Download> Downloads = new()
    {
        new("Windows", "10 / 11 · x64"),
        new("macOS", "Apple Silicon / Intel"),
        new("Linux", "x64 · AppImage / deb / rpm"),
        new("Arch Linux", "AUR 包"),
    };

    private async Task OpenUrl(string url)
        => await JS.InvokeVoidAsync("open", url, "_blank", "noopener");

    private async Task CopyQQ()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", QQ);
        _copied = true;
        await Task.Delay(1500);
        _copied = false;
    }
}
