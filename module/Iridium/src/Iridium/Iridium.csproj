<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Flurl.Http" Version="4.0.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Iridium.SourceGenerators\Iridium.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- macOS JIT SIGBUS workaround dylib (arm64).
         Copied next to the launcher so DYLD_INSERT_LIBRARIES can preload it
         into the spawned JVM, fixing CodeHeap::allocate SIGBUS when SIP/AMFI
         is disabled (amfi_get_out_of_my_way=1). -->
    <ItemGroup Condition="'$(OS)' == 'OSX' Or Exists('runtimes/osx-arm64/native/libjvm_sigbus_fix.dylib')">
      <Content Include="runtimes/osx-arm64/native/libjvm_sigbus_fix.dylib">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>runtimes/osx-arm64/native/libjvm_sigbus_fix.dylib</Link>
      </Content>
    </ItemGroup>

</Project>
